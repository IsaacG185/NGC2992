			      0xa23582, 0x3c3c3c, 0xb8850a, 0x006374]);
add_color_palette("sb:colorblind", [0x0173b2, 0xde8f05, 0x029e73, 0xd55e00, 0xcc78bc, 0xca9161,
				    0xfbafe4, 0x949494, 0xece133, 0x56b4e9]);
%!%+
%\function{palette--sb}
%\synopsis{Get Seaborn color paletts}
%\usage{UInt_Type[] get_color_paletts("sb:"+name, UInt_Type n);}
%\description
%  The seaborn paletts are a very good set of colors for qualitative
%  representation of data (like lines, points, etc.).
%!%-

%}}}

private define hsl_palette (n)
%!%+
%\function{palette--hsl}
%\synopsis{Generate palette from HSL space}
%\usage{UInt_Type[] palette = get_color_palette ("hsl", UInt_Type n);}
%\qualifiers{
%\qualifier{h[=0.01]}{Starting hue}
%\qualifier{s[=0.65]}{Saturation}
%\qualifier{l[=0.60]}{Lightness}
%}
%\description
%  Create a color palette with \code{n} entries. Control the
%  appearence with the HSL qualifiers.
%\seealso{hsl2rgb}
%!%-
{
  variable hues = ([0:1:#n]+qualifier("h", 0.01)) mod 1.0;
  hues -= int(hues);

  return rgb2color(hsl2rgb(hues, qualifier("s", 0.65), qualifier("l", 0.6)));
}

private define hsluv_palette (n)
%!%+
%\function{palette--hsluv}
%\synopsis{Generate palette from HSLuv space}
%\usage{UInt_Type[] palette = get_color_palette ("hsluv", UInt_Type n);}
%\qualifiers{
%\qualifier{h[=0.01]}{Starting hue}
%\qualifier{s[=0.90]}{Saturation}
%\qualifier{l[=0.60]}{Lightness}
%}
%\description
%  Create a color palette with \code{n} entries. Control the
%  appearence with the HSL qualifiers.
%\seealso{hsluv2rgb}
%!%-
{
  variable hues = ([0:1:#n]+qualifier("h", 0.01)) mod 1.0;
  hues -= int(hues);

  return rgb2color(hsluv2rgb(hues, qualifier("s", 0.9), qualifier("l", 0.6)));
}

private define hpluv_palette (n)
%!%+
%\function{palette--hpluv}
%\synopsis{Generate palette from HSLuv space}
%\usage{UInt_Type[] palette = get_color_palette ("hpluv", UInt_Type n);}
%\qualifiers{
%\qualifier{h[=0.01]}{Starting hue}
%\qualifier{s[=0.90]}{Saturation}
%\qualifier{l[=0.60]}{Lightness}
%}
%\description
%  Create a color palette with \code{n} entries. Control the
%  appearence with the HSL qualifiers.
%\seealso{hpluv2rgb}
%!%-
{
  variable hues = ([0:1:#n]+qualifier("h", 0.01)) mod 1.0;
  hues -= int(hues);

  return rgb2color(hsluv2rgb(hues, qualifier("s", 0.9), qualifier("l", 0.6)));
}

% HSL, HSLuv palettes %{{{
add_color_palette("hsl", &hsl_palette);
add_color_palette("hsluv", &hsluv_palette);
add_color_palette("hpluv", &hpluv_palette);
%}}}

% SRON (Paul Tol) palettes %{{{
private define sron_palette (n)
%!%+
%\function{palette--sron-rainbow}
%\synopsis{Get SRON rainbow palette from Paul Tol}
%\usage{UInt_Type[] palette = get_color_palette("sron-rainbow", UInt_Type n);}
%\description
%  Returns a set of colors more or less like rainbow colors with good contrast.
%  \code{n} makes a smart subset up to 23.
%!%-
{
  variable colors = [0xe8ecfb, 0xd9cce3, 0xd1bbd7, 0xcaaccb, 0xba8db4, 0xae76a3,
		     0xaa6f9e, 0x994f88, 0x882e72, 0x1965b0, 0x437dbf, 0x5289c7,
		     0x6195cf, 0x7bafde, 0x4eb265, 0x90c987, 0xcae0ab, 0xf7f056,
		     0xf7cb45, 0xf6c141, 0xf4a736, 0xf1932d, 0xee8026, 0xe8601c,
		     0xe65518, 0xdc050c, 0xa5170e, 0x72190e, 0x42150a, 0x777777];
  variable selector = {
    [10],
    [10, 26],
    [10, 18, 26],
    [10, 15, 18, 26],
    [10, 14, 15, 18, 26],
    [10, 14, 15, 17, 18, 26],
    [9, 10, 14, 15, 17, 18, 26],
    [9, 10, 14, 15, 17, 18, 23, 26],
    [9, 10, 14, 15, 17, 18, 23, 26, 28],
    [9, 10, 14, 15, 17, 18, 21, 24, 26, 28],
    [9, 10, 12, 14, 15, 17, 18, 21, 24, 26, 28],
    [3, 6, 9, 10, 12, 14, 15, 17, 18, 21, 24, 26],
    [3, 6, 9, 10, 12, 14, 15, 16, 17, 18, 21, 24, 26],
    [3, 6, 9, 10, 12, 14, 15, 16, 17, 18, 20, 22, 24, 26],
    [3, 6, 9, 10, 12, 14, 15, 16, 17, 18, 20, 22, 24, 26, 28],
    [3, 5, 7, 9, 10, 12, 14, 15, 16, 17, 18, 20, 22, 24, 26, 28],
    [3, 5, 7, 8, 9, 10, 12, 14, 15, 16, 17, 18, 20, 22, 24, 26, 28],
    [3, 5, 7, 8, 9, 10, 12, 14, 15, 16, 17, 18, 20, 22, 24, 26, 27, 28],
    [2, 4, 5, 7, 8, 9, 10, 12, 14, 15, 16, 17, 18, 20, 22, 24, 26, 27, 28],
    [2, 4, 5, 7, 8, 9, 10, 11, 13, 14, 15, 16, 17, 18, 20, 22, 24, 26, 27, 28],
    [2, 4, 5, 7, 8, 9, 10, 11, 13, 14, 15, 16, 17, 18, 19, 21, 23, 25, 26, 27, 28],
    [2, 4, 5, 7, 8, 9, 10, 11, 13, 14, 15, 16, 17, 18, 19, 21, 23, 25, 26, 27, 28, 29],
    [1, 2, 4, 5, 7, 8, 9, 10, 11, 13, 14, 15, 16, 17, 18, 19, 21, 23, 25, 26, 27, 28, 29]};

  if (n > length(selector))
    n = length(selector);

  return colors[selector[n-1]];
}
add_color_palette("sron-rainbow", &sron_palette);

