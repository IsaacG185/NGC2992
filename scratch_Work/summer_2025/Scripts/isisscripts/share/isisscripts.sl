  217.63, 217.52, 217.52, 217.52, 217.52, 217.29, 217.29, 217.18, 217.18, 217.07, 216.96, 216.96, 216.96, 216.96, 216.96, 216.96, 216.96,
  216.85, 216.85, 216.85, 216.85, 216.73, 216.73, 216.73, 216.73, 216.62, 216.62, 216.51, 216.51, 216.51, 216.51, 216.51, 216.51, 216.40,
  216.40, 216.40, 216.29, 216.29, 216.29, 216.29, 216.29, 216.17, 216.17, 216.06, 216.06, 216.06, 216.06, 216.06, 216.06, 215.95, 215.84,
  215.84, 215.61, 215.73, 215.73]); }
