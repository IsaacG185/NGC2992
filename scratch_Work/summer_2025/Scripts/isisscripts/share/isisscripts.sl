  _pgaxis(qualifier("opt", opt), x, ymin, x, ymax,
          min_value, max_value,  step, qualifier("nsub", 0),
          qualifier("maji", 0.5), qualifier("majo", 0), qualifier("fmin", 0.5), qualifier("disp", 0.5),
          qualifier("angle", 0)
         );
}

