  % );
  % variable err = array_flatten(array_struct_field(data, "err"));
  % data = array_flatten(array_struct_field(data, "value"));
  % variable mdl = array_flatten(array_struct_field(array_map(
  %   Struct_Type, &get_model_counts, all_data
  % ), "value"));
