      return param_default_structure(0.1,1,0.,0.5,0.,1.,1.e-3,1.e-3);
   }
   {case 1:
      return param_default_structure(1,1,0,48,0,100,1,1);
   }
   {case 2:
      return param_default_structure(2,1,0,48,0,100,1,1);
